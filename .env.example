# ─────────────────────────────────────────────────────────────────
# Expense Tracker — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
# .env is gitignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME="Expense Tracker"

# Set to "production" (or "staging") to enable production safety checks.
# Development default: "development"
ENVIRONMENT="development"

# Set DEBUG=False in production. Disables /docs endpoint and reduces log noise.
DEBUG=True

PORT=8000
HOST="127.0.0.1"

# ── Security ─────────────────────────────────────────────────────
# REQUIRED in production: generate a strong random secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The application will refuse to start in production with the default value.
# Development fallback below is for LOCAL USE ONLY — never use in production.
SECRET_KEY="decode-labs-super-secret-key-change-in-production"

SESSION_COOKIE_NAME="expense_session"
SESSION_MAX_AGE=86400

# Set SECURE_COOKIE=True when running behind HTTPS in production.
# Must be False for local HTTP development (http://127.0.0.1).
SECURE_COOKIE=False

# ── Production / Reverse Proxy ────────────────────────────────────
# Comma-separated list of allowed hostnames.
# Leave empty in development (unrestricted). Set explicitly in production.
# Example: ALLOWED_HOSTS="yourdomain.com,www.yourdomain.com"
ALLOWED_HOSTS=""

# Enable Strict-Transport-Security header ONLY when running behind HTTPS.
# Never set True on plain HTTP.
HSTS_ENABLED=False

# ── Database ─────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="sqlite+aiosqlite:///./expense_tracker.db"

# Production (PostgreSQL via asyncpg):
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/finance_tracker"
# Run "alembic upgrade head" after configuring a PostgreSQL URL.

# ── Google OAuth 2.0 (Optional) ──────────────────────────────────
# Leave empty to disable Google login (graceful fallback to email/password).
# Production OAuth requires HTTPS and the correct callback URL registered
# in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Development callback (HTTP):
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
# Production callback (HTTPS):
# GOOGLE_REDIRECT_URI="https://yourdomain.com/auth/google/callback"
